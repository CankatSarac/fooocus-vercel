# Your persistent Fooocus URL (24/7 server required)
# Options: RunPod, Vast.ai, Replicate, or your own server
# Example: https://your-domain.com or https://abc-123.runpod.io
NEXT_PUBLIC_FOOOCUS_URL=https://your-fooocus-server.com
